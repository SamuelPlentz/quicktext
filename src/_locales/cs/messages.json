  "migration.pageTitle": {
    "message": "Migrace Quicktext v$VERSION$",
    "placeholders": { "version": { "content": "$1" } }
  },
  "migration.intro.p1": {
    "message": "Toto je poslední krok dlouhého procesu aktualizace pro převod Quicktext na moderní WebExtension. Quicktext se brzy nebude spoléhat na zastaralá API a neomezený přístup k vašemu počítači, ale bude plně fungovat v rámci moderního frameworku WebExtension - bez nutnosti aktualizace pro každou novou verzi Thunderbirdu."
  },
  "migration.intro.quote": {
    "message": "Děkuji všem svým beta testerům za vaši neustálou podporu a trpělivost, díky nimž byl tento přechod možný. Vaše zpětná vazba byla neocenitelná!"
  },
  "migration.intro.quoteAttribution": {
    "message": "- John Bieling, vývojář Quicktext"
  },
  "migration.intro.p2": {
    "message": "Moderní WebExtensions již nemohou přímo přistupovat k vašemu souborovému systému. Proto jsou vaše definice $ITEMTYPE$ nyní uloženy ve vnitřním úložišti Quicktext a všechny přílohy a obrázky, na které vaše šablony odkazují, musí být také zkopírovány do tohoto úložiště.",
    "placeholders": { "itemtype": { "content": "$1" } }
  },
  "migration.intro.itemType.template": {
    "message": "šablon"
  },
  "migration.intro.itemType.templateAndScript": {
    "message": "šablon a skriptů"
  },
  "migration.intro.p3": {
    "message": "Po migraci můžete nainstalovat další $LINK$ a přesunout celou konfiguraci Quicktext, například na server WebDAV.",
    "placeholders": { "link": { "content": "$1" } }
  },
  "migration.intro.p3.linkText": {
    "message": "backendy úložišť"
  },
  "migration.section.autoMigration": {
    "message": "Automatická migrace"
  },
  "migration.section.manualMigration": {
    "message": "Vyžadována ruční migrace"
  },
  "migration.section.droppedSources": {
    "message": "Odstraněné zdroje konfigurace"
  },
  "migration.auto.intro": {
    "message": "Následující šablony lze migrovat automaticky. Lokální soubory budou zkopírovány do vnitřního úložiště Quicktext a všechny tagy ve vašich šablonách odkazující na tyto soubory budou upraveny."
  },
  "migration.btn.startMigration": {
    "message": "Spustit migraci šablon"
  },
  "migration.btn.startMigrationCount": {
    "message": "Spustit migraci ($COUNT$ položek)",
