  "migration.manual.intro": {
    "message": "Níže uvedené položky nelze migrovat automaticky a vyžadují ruční zásah."
  },
  "migration.incompatible.title": {
    "message": "Nekompatibilní skripty"
  },
  "migration.incompatible.description": {
    "message": "Tyto skripty používají zastaralá API Quicktext v5, která již nejsou dostupná. Je nutné je přepsat pomocí $LINK$.",
    "placeholders": { "link": { "content": "$1" } }
  },
  "migration.incompatible.linkText": {
    "message": "moderního skriptovacího API"
  },
  "migration.filesystem.title": {
    "message": "Zastaralý přístup k souborovému systému"
  },
  "migration.filesystem.description": {
    "message": "Tyto šablony a skripty odkazují na soubory ve vašem lokálním souborovém systému, ke kterému WebExtensions již nemají přímý přístup. Odkazované soubory je nutné zkopírovat do úložiště Quicktext a šablony odpovídajícím způsobem upravit. Podrobnosti najdete v $LINK$.",
    "placeholders": { "link": { "content": "$1" } }
  },
  "migration.filesystem.linkText": {
    "message": "průvodci úložišti"
  },
  "migration.dropped.intro": {
    "message": "Následující zdroje konfigurace se spoléhaly na přímý přístup k souborovému systému, který v moderních WebExtensions již není dostupný."
  },
  "migration.dropped.description": {
    "message": "Pokud jste dříve používali místní složku pro ukládání šablon nebo jejich sdílení mezi počítači, můžete jako náhradu nainstalovat $VFSLINK$ - například $WEBDAVLINK$ pro ukládání šablon na serveru WebDAV (ownCloud, Nextcloud atd.), nebo $HOMEFOLDERLINK$ pro pokračování v používání složky na vašem počítači.",
